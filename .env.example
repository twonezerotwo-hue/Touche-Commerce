# ===========================================================================
# TOUCHE COMMERCE — local development environment template
# ===========================================================================
# Copy this file to `.env` (never commit `.env`):
#   PowerShell : Copy-Item .env.example .env
#   bash       : cp .env.example .env
#
# ALL credentials below are LOCAL DEVELOPMENT ONLY throw-away values.
# Real environments must provide secrets through the platform secret store
# (never through a committed file).
# ===========================================================================

# --- Application -----------------------------------------------------------
TOUCHE_ENVIRONMENT=local
TOUCHE_DEBUG=false
TOUCHE_LOG_LEVEL=INFO
TOUCHE_LOG_FORMAT=json
TOUCHE_APP_VERSION=0.1.0

# --- CORS (frontend origins allowed to call the API) -----------------------
TOUCHE_CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# --- PostgreSQL connection settings ---------------------------------------
# Used by infra/docker-compose.yml and by scripts/db/bootstrap-local-postgres.ps1
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=touche_commerce

# Bootstrap superuser (local cluster / container only)
POSTGRES_ADMIN_USER=touche_admin
POSTGRES_ADMIN_PASSWORD=touche_dev_admin_pw_2026
POSTGRES_ADMIN_DB=postgres

# Two distinct least-privilege roles (see docs/DECISIONS.md #4):
#   - touche_migrator : owns the schema, runs Alembic migrations
#   - touche_app      : runtime role, no DDL, NOBYPASSRLS
TOUCHE_DB_MIGRATOR_USER=touche_migrator
TOUCHE_DB_MIGRATOR_PASSWORD=touche_dev_migrator_pw_2026
TOUCHE_DB_APP_USER=touche_app
TOUCHE_DB_APP_PASSWORD=touche_dev_app_pw_2026

# --- Database URLs consumed by the API ------------------------------------
# Percent-encode any reserved character in the password.
TOUCHE_DATABASE_URL=postgresql+psycopg://touche_app:touche_dev_app_pw_2026@127.0.0.1:5432/touche_commerce
TOUCHE_DATABASE_MIGRATION_URL=postgresql+psycopg://touche_migrator:touche_dev_migrator_pw_2026@127.0.0.1:5432/touche_commerce

# --- Database pool / timeouts ---------------------------------------------
TOUCHE_DATABASE_POOL_SIZE=5
TOUCHE_DATABASE_POOL_MAX_OVERFLOW=5
TOUCHE_DATABASE_CONNECT_TIMEOUT_SECONDS=3
TOUCHE_DATABASE_STATEMENT_TIMEOUT_MS=5000
TOUCHE_DATABASE_SSL_MODE=prefer

# --- Session policy (initial values; enforced from Stage 1A) --------------
TOUCHE_SESSION_IDLE_TIMEOUT_SECONDS=1800
TOUCHE_SESSION_ABSOLUTE_TIMEOUT_SECONDS=43200
TOUCHE_SESSION_COOKIE_NAME=touche_session
TOUCHE_SESSION_COOKIE_SECURE=false

# --- Rate limiting (Stage 1A) ---------------------------------------------
TOUCHE_LOGIN_RATE_LIMIT_ATTEMPTS=10
TOUCHE_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# --- Idempotency / pagination ---------------------------------------------
TOUCHE_IDEMPOTENCY_TTL_HOURS=24
TOUCHE_PAGINATION_DEFAULT_LIMIT=25
TOUCHE_PAGINATION_MAX_LIMIT=100

# --- Integration tests (optional) -----------------------------------------
# Set to a disposable database owned by the migration role to enable the
# live-database integration tests (pytest -m integration).
# TOUCHE_TEST_DATABASE_MIGRATION_URL=postgresql+psycopg://touche_migrator:touche_dev_migrator_pw_2026@127.0.0.1:5432/touche_commerce_test
