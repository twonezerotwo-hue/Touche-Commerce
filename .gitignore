# ---------------------------------------------------------------------------
# TOUCHE COMMERCE — repository ignore rules
# ---------------------------------------------------------------------------

# Environment / secrets -----------------------------------------------------
.env
.env.*
!.env.example
!**/.env.example
frontend/.env.local
frontend/.env.local.example
*.pem
*.key
!**/*.example.key

# Python --------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.log

# Node / Next.js ------------------------------------------------------------
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
coverage/
frontend/.next/
frontend/node_modules/

# Local infrastructure (portable PostgreSQL, data directories) --------------
infra/.local/
infra/pgdata/
infra/postgres-data/

# Backend runtime state (private document storage, verification temp dirs) ---
backend/var/

# Editors / OS --------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# Scratch -------------------------------------------------------------------
tmp/
.tmp/
scratch/
