# Base URL of the TOUCHE COMMERCE API as seen by the server (SSR + proxy target).
# Browser-exposed configuration only — never put credentials in NEXT_PUBLIC_*.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional internal address for the same-origin proxy (e.g. http://api:8000 in a
# container network). Server-only: not exposed to the browser. Defaults to
# NEXT_PUBLIC_API_BASE_URL when unset.
# API_INTERNAL_BASE_URL=http://127.0.0.1:8000

# Request budget for server-side session/probe calls (milliseconds).
NEXT_PUBLIC_API_TIMEOUT_MS=10000

