{
  "components": {
    "schemas": {
      "AuthSessionResponse": {
        "description": "Body returned by login, company switch and ``GET /auth/me``.",
        "properties": {
          "memberships": {
            "description": "Every company this user may still access.",
            "items": {
              "$ref": "#/components/schemas/CompanyAccess"
            },
            "title": "Memberships",
            "type": "array"
          },
          "session": {
            "$ref": "#/components/schemas/SessionView"
          },
          "user": {
            "$ref": "#/components/schemas/SessionUser"
          }
        },
        "required": [
          "user",
          "session",
          "memberships"
        ],
        "title": "AuthSessionResponse",
        "type": "object"
      },
      "CompanyAccess": {
        "description": "One company the signed-in user may access, with their role there.",
        "properties": {
          "company_id": {
            "format": "uuid",
            "title": "Company Id",
            "type": "string"
          },
          "country": {
            "description": "ISO 3166-1 alpha-2 country code.",
            "title": "Country",
            "type": "string"
          },
          "default_currency": {
            "description": "ISO 4217 currency code.",
            "title": "Default Currency",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "permissions": {
            "description": "Permissions granted by this membership.",
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "role": {
            "description": "viewer, trader, approver or admin.",
            "title": "Role",
            "type": "string"
          },
          "status": {
            "description": "Company status: active, suspended or archived.",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "company_id",
          "name",
          "country",
          "default_currency",
          "status",
          "role",
          "permissions"
        ],
        "title": "CompanyAccess",
        "type": "object"
      },
      "CompanyListResponse": {
        "description": "Companies available to the caller and the currently active one.",
        "properties": {
          "active_company_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Active Company Id"
          },
          "companies": {
            "items": {
              "$ref": "#/components/schemas/CompanyAccess"
            },
            "title": "Companies",
            "type": "array"
          }
        },
        "required": [
          "companies",
          "active_company_id"
        ],
        "title": "CompanyListResponse",
        "type": "object"
      },
      "CompanySwitchRequest": {
        "description": "Select the active company for this session.",
        "properties": {
          "company_id": {
            "format": "uuid",
            "title": "Company Id",
            "type": "string"
          }
        },
        "required": [
          "company_id"
        ],
        "title": "CompanySwitchRequest",
        "type": "object"
      },
      "ErrorDetail": {
        "description": "Machine readable error description.",
        "properties": {
          "code": {
            "description": "Stable error code, e.g. NOT_READY.",
            "title": "Code",
            "type": "string"
          },
          "details": {
            "anyOf": [
              {},
              {
                "type": "null"
              }
            ],
            "description": "Optional structured context.",
            "title": "Details"
          },
          "message": {
            "description": "Human readable message (safe to display).",
            "title": "Message",
            "type": "string"
          },
          "request_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Correlation id for support.",
            "title": "Request Id"
          },
          "timestamp": {
            "description": "UTC timestamp of the error.",
            "format": "date-time",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "timestamp"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "Every non-2xx response uses this envelope.",
        "example": {
          "error": {
            "code": "NOT_READY",
            "message": "The service is not ready to handle requests.",
            "request_id": "9f1c2b7d4a8e4c1b9d0e5f6a7b8c9d0e",
            "timestamp": "2026-10-22T09:30:00+00:00"
          }
        },
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthCheckResult": {
        "description": "Outcome of a single dependency check.",
        "properties": {
          "detail": {
            "description": "Human readable, credential-free detail.",
            "title": "Detail",
            "type": "string"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Machine readable failure reason when status is 'error'.",
            "title": "Error Code"
          },
          "latency_ms": {
            "description": "Probe duration in milliseconds.",
            "minimum": 0.0,
            "title": "Latency Ms",
            "type": "number"
          },
          "name": {
            "description": "Dependency name, e.g. 'database'.",
            "title": "Name",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "name",
          "status",
          "latency_ms",
          "detail"
        ],
        "title": "HealthCheckResult",
        "type": "object"
      },
      "HealthLiveResponse": {
        "description": "Liveness result: proves the process is running and serving HTTP.",
        "example": {
          "checked_at": "2026-10-22T09:30:00+00:00",
          "environment": "local",
          "service": "touche-commerce-api",
          "status": "ok",
          "version": "0.1.0"
        },
        "properties": {
          "checked_at": {
            "description": "Server-side UTC timestamp of the probe.",
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "environment": {
            "description": "Deployment environment name.",
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "description": "Service identifier.",
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "description": "Deployed application version.",
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version",
          "environment",
          "checked_at"
        ],
        "title": "HealthLiveResponse",
        "type": "object"
      },
      "LoginRequest": {
        "description": "Credentials submitted from the sign-in screen.",
        "example": {
          "email": "amina@touche.example",
          "password": "correct horse battery"
        },
        "properties": {
          "email": {
            "description": "Account email (case-insensitive).",
            "format": "email",
            "title": "Email",
            "type": "string"
          },
          "password": {
            "description": "Account password.",
            "maxLength": 512,
            "minLength": 1,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest",
        "type": "object"
      },
      "LogoutResponse": {
        "properties": {
          "status": {
            "const": "signed_out",
            "default": "signed_out",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "LogoutResponse",
        "type": "object"
      },
      "ReadinessResponse": {
        "description": "Readiness result: proves required dependencies are usable.",
        "example": {
          "checked_at": "2026-10-22T09:30:00+00:00",
          "checks": [
            {
              "detail": "PostgreSQL 17.6 reachable as role 'touche_app'.",
              "latency_ms": 4.12,
              "name": "database",
              "status": "ok"
            }
          ],
          "environment": "local",
          "service": "touche-commerce-api",
          "status": "ready",
          "version": "0.1.0"
        },
        "properties": {
          "checked_at": {
            "format": "date-time",
            "title": "Checked At",
            "type": "string"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/HealthCheckResult"
            },
            "title": "Checks",
            "type": "array"
          },
          "environment": {
            "title": "Environment",
            "type": "string"
          },
          "service": {
            "title": "Service",
            "type": "string"
          },
          "status": {
            "const": "ready",
            "default": "ready",
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "service",
          "version",
          "environment",
          "checked_at",
          "checks"
        ],
        "title": "ReadinessResponse",
        "type": "object"
      },
      "SessionUser": {
        "description": "The authenticated actor.",
        "properties": {
          "display_name": {
            "title": "Display Name",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email",
          "display_name",
          "status"
        ],
        "title": "SessionUser",
        "type": "object"
      },
      "SessionView": {
        "description": "Server-side session metadata. The token itself is only ever in the cookie.",
        "properties": {
          "company": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CompanyAccess"
              },
              {
                "type": "null"
              }
            ],
            "description": "Active company, or null when a choice is required."
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "csrf_token": {
            "description": "Send as the CSRF header on every state-changing request.",
            "title": "Csrf Token",
            "type": "string"
          },
          "expires_at": {
            "description": "Absolute expiry, fixed at login.",
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "idle_expires_at": {
            "format": "date-time",
            "title": "Idle Expires At",
            "type": "string"
          },
          "ip_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip Address"
          },
          "last_activity_at": {
            "format": "date-time",
            "title": "Last Activity At",
            "type": "string"
          },
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          }
        },
        "required": [
          "session_id",
          "created_at",
          "last_activity_at",
          "idle_expires_at",
          "expires_at",
          "csrf_token"
        ],
        "title": "SessionView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "TOUCHE COMMERCE trade management API. Stage 1A exposes identity (server-side sessions), multi-company membership and tenant isolation on top of the Stage 0 foundation.",
    "title": "TOUCHE COMMERCE API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "operationId": "service_descriptor__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Service Descriptor  Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Service descriptor",
        "tags": [
          "meta"
        ]
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "description": "Verifies the credentials with Argon2id, applies the login rate limit and creates a server-side session. The opaque session token is delivered in an HttpOnly cookie; the body never contains the token or the password hash. All failures return the same 401 message so account existence is not revealed. The active company is auto-selected only when the user has exactly one active membership.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            },
            "description": "Session created."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Invalid credentials (generic)."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Origin not allowed."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too many attempts; honour Retry-After."
          }
        },
        "summary": "Sign in and open a server-side session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Revokes the session row immediately (the cookie alone would be useless afterwards) and clears the cookie. Requires the CSRF header.",
        "operationId": "logout_api_v1_auth_logout_post",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LogoutResponse"
                }
              }
            },
            "description": "Session revoked."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "No valid session."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "CSRF token or origin rejected."
          }
        },
        "summary": "Revoke the current session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "description": "Re-validates the session and the active membership on every call and returns the CSRF token the client must send on state-changing requests.",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            },
            "description": "Authenticated session."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "No valid session."
          }
        },
        "summary": "Current user, active company and memberships",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/companies": {
      "get": {
        "description": "Returns only companies with an active membership for the caller, together with the role and permissions held in each. The list is derived from the database on every request, so a revoked membership disappears immediately.",
        "operationId": "list_companies_api_v1_companies_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompanyListResponse"
                }
              }
            },
            "description": "Accessible companies."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "No valid session."
          }
        },
        "summary": "Companies the signed-in user may access",
        "tags": [
          "companies"
        ]
      }
    },
    "/api/v1/health/live": {
      "get": {
        "description": "Returns 200 as soon as the API process can serve HTTP. It deliberately performs no database, cache or network I/O so a dependency outage cannot cause the orchestrator to kill a healthy process.",
        "operationId": "health_live_api_v1_health_live_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthLiveResponse"
                }
              }
            },
            "description": "The service process is alive."
          }
        },
        "summary": "Liveness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "description": "Verifies that required dependencies are usable. Currently checks the PostgreSQL connection using the runtime role. Returns 503 with the standard error envelope when a dependency is unavailable.",
        "operationId": "health_ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            },
            "description": "All required dependencies are reachable."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "A required dependency is unavailable."
          }
        },
        "summary": "Readiness probe",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/session/company": {
      "post": {
        "description": "Requires a CSRF header and an active membership for the requested company. The company id supplied by the client is only used as a lookup key: an unauthorised id returns 403 and writes an ACCESS_DENIED audit record. On success the session token and CSRF token are rotated and the absolute expiry is preserved.",
        "operationId": "switch_company_api_v1_session_company_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompanySwitchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            },
            "description": "Active company changed."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "No valid session."
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "No membership, CSRF or origin rejected."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Select the active company and rotate the session token",
        "tags": [
          "companies"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Liveness and readiness probes used by the UI and orchestrators.",
      "name": "health"
    },
    {
      "description": "Sign-in, sign-out and the current session profile. Sessions are server-side rows; the browser holds only an HttpOnly cookie.",
      "name": "auth"
    },
    {
      "description": "Company discovery and active-company selection. Access is always derived from verified memberships, never from a client-supplied id.",
      "name": "companies"
    },
    {
      "description": "Service identity and discovery endpoints.",
      "name": "meta"
    }
  ]
}
